---
import BaseLayout from '@layouts/Base.astro';
---

<BaseLayout
  title="Billing & Account | Addy AI"
  description="Manage Addy AI billing, subscription, and customer portal."
>
  <main class="account">
    <section class="card">
      <h1>Billing &amp; customer portal</h1>
      <p>
        Manage your subscription, payment method, and invoices in the Stripe customer portal.
      </p>
      <div class="card-actions">
        <button class="primary">Open Stripe portal</button>
        <a class="ghost" href="/app">Back to dashboard</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style lang="scss">
  @import '@styles/global.scss';

  .account {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 3rem 1.5rem;
    background: var(--background);
  }

  .card {
    background: white;
    padding: 2.5rem;
    border-radius: 24px;
    box-shadow: 0 30px 80px rgba(15, 23, 42, 0.12);
    display: grid;
    gap: 1rem;
    max-width: 480px;
    width: 100%;
  }

  .card p {
    color: var(--text-color-secondary);
  }

  .card-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .primary,
  .ghost {
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    border: none;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
  }

  .primary {
    background: var(--primary);
    color: white;
  }

  .ghost {
    border: 1px solid var(--primary);
    color: var(--primary);
    background: transparent;
  }
</style>
