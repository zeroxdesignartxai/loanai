---
import BaseLayout from '@layouts/Base.astro';

const pageTitle = 'AI Loan Officer Assistant (Addy AI)';
const pageDescription =
  'Close mortgage loans 90% faster with AI-driven document processing, borrower follow-ups, and underwriting checks.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="page">
    <header class="nav">
      <div class="logo">
        <span class="logo-mark">Addy</span>
        <span class="logo-sub">AI Loan Officer Assistant</span>
      </div>
      <nav class="nav-links">
        <a href="#benefits">Benefits</a>
        <a href="#how-it-works">How it Works</a>
        <a href="#document-ai">Document AI</a>
        <a href="#reviews">Reviews</a>
        <a href="#leadership">Leadership</a>
        <a class="pill" href="/login">Login</a>
      </nav>
      <div class="nav-actions">
        <a class="ghost" href="#demo">Book a Demo</a>
        <a class="primary" href="/signup">Try it now</a>
      </div>
    </header>

    <section class="hero">
      <div class="hero-content">
        <p class="eyebrow">AI Loan Officer Assistant SaaS</p>
        <h1>Close mortgage loans 90% faster.</h1>
        <p class="lead">
          Addy AI helps mortgage professionals automate document intake, borrower follow-ups, and underwriting checks
          so every loan file is always complete, compliant, and ready to close.
        </p>
        <div class="hero-actions">
          <a class="primary" href="/signup">Start free trial</a>
          <a class="ghost" href="#demo">Book a Demo</a>
        </div>
        <div class="hero-meta">
          <div>
            <strong>24/7</strong>
            <span>borrower follow-ups</span>
          </div>
          <div>
            <strong>Stripe</strong>
            <span>secure billing &amp; portal</span>
          </div>
          <div>
            <strong>Google</strong>
            <span>single sign-on</span>
          </div>
        </div>
      </div>
      <div class="hero-card">
        <div class="card-header">
          <span>Live Loan File</span>
          <span class="status">Processing</span>
        </div>
        <div class="card-body">
          <div class="card-row">
            <p>Borrower</p>
            <strong>Andrea Morales</strong>
          </div>
          <div class="card-row">
            <p>Pipeline Stage</p>
            <strong>Underwriting Review</strong>
          </div>
          <div class="card-row">
            <p>Next Action</p>
            <strong>Request updated pay stub</strong>
          </div>
          <div class="card-checklist">
            <div class="check complete">W2 (2023)</div>
            <div class="check complete">Bank statement (2 months)</div>
            <div class="check">Pay stub (current)</div>
            <div class="check">Letter of explanation</div>
          </div>
          <button class="primary">Send follow-up</button>
        </div>
      </div>
    </section>

    <section id="benefits" class="section">
      <div class="section-heading">
        <h2>Benefits built for modern mortgage teams.</h2>
        <p>Everything you need to move files forward while staying compliant.</p>
      </div>
      <div class="grid three">
        <div class="tile">
          <h3>Automated borrower follow-ups</h3>
          <p>Trigger smart reminders via email and SMS when documents are missing or stale.</p>
        </div>
        <div class="tile">
          <h3>Underwriting-ready checks</h3>
          <p>Instantly spot DTI, income, and asset discrepancies before submitting files.</p>
        </div>
        <div class="tile">
          <h3>Centralized file intelligence</h3>
          <p>Summaries, extracted fields, and next steps are surfaced in one consistent view.</p>
        </div>
      </div>
    </section>

    <section id="how-it-works" class="section highlight">
      <div class="section-heading">
        <h2>How it works</h2>
        <p>A simple workflow that your team can adopt in minutes.</p>
      </div>
      <div class="grid four">
        <div class="tile">
          <span class="step">1</span>
          <h3>Connect your pipeline</h3>
          <p>Securely import loan files or upload PDFs directly from your LOS.</p>
        </div>
        <div class="tile">
          <span class="step">2</span>
          <h3>Choose an AI task</h3>
          <p>Run missing doc checks, DTI analysis, or file summaries instantly.</p>
        </div>
        <div class="tile">
          <span class="step">3</span>
          <h3>Automate borrower requests</h3>
          <p>Send templated follow-ups with secure upload links.</p>
        </div>
        <div class="tile">
          <span class="step">4</span>
          <h3>Ship a complete file</h3>
          <p>Track readiness with a checklist and compliance markers.</p>
        </div>
      </div>
    </section>

    <section id="document-ai" class="section">
      <div class="section-heading">
        <h2>Document AI for mortgage underwriting.</h2>
        <p>Extract income, assets, and liabilities from every document type.</p>
      </div>
      <div class="grid two">
        <div class="tile">
          <h3>Supported documents</h3>
          <ul>
            <li>W2s, 1099s, and 1040 tax returns</li>
            <li>Pay stubs, VOE, and employment letters</li>
            <li>Bank statements and asset statements</li>
            <li>Credit reports and liability disclosures</li>
          </ul>
        </div>
        <div class="tile">
          <h3>AI results view</h3>
          <p>Every extraction includes confidence scores, derived ratios, and a compliance checklist.</p>
          <div class="chip-row">
            <span>DTI 38%</span>
            <span>Income verified</span>
            <span>Assets matched</span>
          </div>
        </div>
      </div>
    </section>

    <section id="extension" class="section highlight">
      <div class="section-heading">
        <h2>Browser extension + LOS-ready.</h2>
        <p>Capture documents from any portal and sync instantly with Addy AI.</p>
      </div>
      <div class="grid three">
        <div class="tile">
          <h3>One-click capture</h3>
          <p>Grab PDFs directly from investor or client portals with secure tracking.</p>
        </div>
        <div class="tile">
          <h3>Smart naming</h3>
          <p>Auto-label documents based on borrower, property, and loan number.</p>
        </div>
        <div class="tile">
          <h3>Compliance logging</h3>
          <p>Store audit-ready activity logs for every document touchpoint.</p>
        </div>
      </div>
    </section>

    <section id="reviews" class="section">
      <div class="section-heading">
        <h2>Loved by high-performing mortgage teams.</h2>
        <p>Trusted by loan officers, processors, and branch leaders.</p>
      </div>
      <div class="grid three">
        <div class="tile quote">
          <p>
            “Addy AI saved us 12 hours per file. Borrowers respond faster and our conditions are cleaner.”
          </p>
          <strong>— Jasmine Reed, Branch Manager</strong>
        </div>
        <div class="tile quote">
          <p>
            “We reduced doc chases by 70%. The summaries make underwriting calls so much faster.”
          </p>
          <strong>— Michael Chen, Senior LO</strong>
        </div>
        <div class="tile quote">
          <p>
            “Our compliance team loves the automated checklists and audit logs.”
          </p>
          <strong>— Priya Patel, Operations Lead</strong>
        </div>
      </div>
    </section>

    <section id="leadership" class="section highlight">
      <div class="section-heading">
        <h2>Leadership built for mortgage scale.</h2>
        <p>Enterprise-ready architecture with admin controls coming soon.</p>
      </div>
      <div class="grid two">
        <div class="tile">
          <h3>Future-ready admin suite</h3>
          <p>
            Role-based access, audit trails, and multi-branch reporting are already mapped into the
            product architecture.
          </p>
        </div>
        <div class="tile">
          <h3>Stripe billing &amp; portal</h3>
          <p>Launch with a free trial, one monthly plan, and self-serve billing management.</p>
          <div class="chip-row">
            <span>Free trial</span>
            <span>Monthly plan</span>
            <span>Customer portal</span>
          </div>
        </div>
      </div>
    </section>

    <section id="demo" class="section demo">
      <div class="section-heading">
        <h2>Book a demo in minutes.</h2>
        <p>Get a tailored walkthrough for your lending team.</p>
      </div>
      <div class="demo-card">
        <div>
          <h3>Talk to a mortgage AI specialist</h3>
          <p>We’ll show you how Addy AI integrates with your LOS and document workflow.</p>
        </div>
        <form class="demo-form">
          <input type="text" placeholder="Full name" aria-label="Full name" />
          <input type="email" placeholder="Work email" aria-label="Work email" />
          <input type="text" placeholder="Company" aria-label="Company" />
          <button class="primary" type="submit">Book a Demo</button>
        </form>
      </div>
    </section>

    <footer class="footer">
      <div>
        <strong>Addy AI</strong>
        <p>AI Loan Officer Assistant for modern mortgage teams.</p>
      </div>
      <div class="footer-links">
        <a href="/signup">Start free trial</a>
        <a href="/app">Open dashboard</a>
        <a href="mailto:hello@addyai.com">Contact</a>
      </div>
    </footer>
  </main>
</BaseLayout>

<style lang="scss">
  @import '@styles/global.scss';

  .page {
    display: flex;
    flex-direction: column;
    gap: 5rem;
    padding: 2.5rem clamp(1.5rem, 4vw, 4.5rem) 4rem;
    background: radial-gradient(circle at top, #eef2ff, transparent 55%) var(--background);
    color: var(--text-color);
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    position: sticky;
    top: 1rem;
    z-index: 10;
    padding: 1rem 1.5rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
    backdrop-filter: blur(12px);
  }

  .logo {
    display: flex;
    flex-direction: column;
    font-weight: 600;
  }

  .logo-mark {
    font-size: 1.4rem;
    color: var(--primary);
  }

  .logo-sub {
    font-size: 0.85rem;
    color: var(--text-color-secondary);
  }

  .nav-links,
  .nav-actions {
    display: flex;
    gap: 1rem;
    align-items: center;
    font-size: 0.95rem;
    color: var(--text-color-secondary);
  }

  .nav-links a:hover {
    color: var(--text-color);
  }

  .pill {
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--background-darker);
  }

  .primary,
  .ghost {
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    border: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    cursor: pointer;
    text-decoration: none;
  }

  .primary {
    background: var(--primary);
    color: white;
    box-shadow: 0 20px 40px rgba(27, 79, 255, 0.25);
  }

  .ghost {
    background: transparent;
    border: 1px solid var(--primary);
    color: var(--primary);
  }

  .hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 3rem;
    align-items: center;
  }

  .hero-content h1 {
    font-size: clamp(2.5rem, 3vw + 2rem, 3.8rem);
    margin-bottom: 1.5rem;
  }

  .lead {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--text-color-secondary);
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.75rem;
    color: var(--primary);
    margin-bottom: 1rem;
  }

  .hero-actions {
    margin-top: 1.5rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-meta {
    margin-top: 2rem;
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    color: var(--text-color-secondary);
  }

  .hero-meta strong {
    display: block;
    color: var(--text-color);
    font-size: 1rem;
  }

  .hero-card {
    background: white;
    border-radius: 24px;
    padding: 1.5rem;
    box-shadow: 0 30px 80px rgba(15, 23, 42, 0.1);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    font-weight: 600;
    color: var(--text-color);
    margin-bottom: 1rem;
  }

  .status {
    background: var(--primary-transparent);
    color: var(--primary);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
  }

  .card-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    font-size: 0.95rem;
  }

  .card-row p {
    color: var(--text-color-secondary);
  }

  .card-checklist {
    display: grid;
    gap: 0.5rem;
    margin: 1rem 0;
  }

  .check {
    padding: 0.5rem 0.75rem;
    border-radius: 12px;
    background: var(--background-darker);
    font-size: 0.85rem;
  }

  .check.complete {
    background: rgba(34, 197, 94, 0.15);
    color: #15803d;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .section-heading h2 {
    font-size: clamp(1.8rem, 1vw + 1.5rem, 2.4rem);
  }

  .section-heading p {
    color: var(--text-color-secondary);
  }

  .grid {
    display: grid;
    gap: 1.5rem;
  }

  .grid.two {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .grid.three {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .grid.four {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .tile {
    background: white;
    padding: 1.5rem;
    border-radius: 20px;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
    line-height: 1.6;
  }

  .tile ul {
    padding-left: 1.2rem;
    color: var(--text-color-secondary);
  }

  .tile p {
    color: var(--text-color-secondary);
  }

  .tile.quote {
    background: var(--background-lighter);
  }

  .highlight {
    background: rgba(255, 255, 255, 0.65);
    padding: 2.5rem;
    border-radius: 32px;
    box-shadow: inset 0 0 0 1px rgba(27, 79, 255, 0.1);
  }

  .step {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    background: var(--primary-transparent);
    color: var(--primary);
    border-radius: 999px;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .chip-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .chip-row span {
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: var(--background-darker);
    font-size: 0.85rem;
    color: var(--text-color-secondary);
  }

  .demo-card {
    background: white;
    border-radius: 24px;
    padding: 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2rem;
    align-items: center;
    box-shadow: 0 25px 70px rgba(15, 23, 42, 0.1);
  }

  .demo-form {
    display: grid;
    gap: 0.75rem;
  }

  .demo-form input {
    padding: 0.75rem 1rem;
    border-radius: 12px;
    border: 1px solid #d8def0;
    background: #f8faff;
  }

  .footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    border-top: 1px solid #e3e8f8;
    padding-top: 2rem;
    color: var(--text-color-secondary);
  }

  .footer strong {
    color: var(--text-color);
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .nav {
      flex-direction: column;
      align-items: flex-start;
    }

    .nav-links {
      flex-wrap: wrap;
    }
  }
  @media (max-width: 640px) {
    .nav {
      position: static;
    }

    .nav-actions {
      width: 100%;
      justify-content: flex-start;
      flex-wrap: wrap;
    }
  }
</style>
