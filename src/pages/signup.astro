---
import BaseLayout from '@layouts/Base.astro';
---

<BaseLayout title="Start Free Trial | Addy AI" description="Start your Addy AI free trial.">
  <main class="auth">
    <section class="card">
      <h1>Start your free trial</h1>
      <p>Try Addy AI with Stripe billing, no setup fees, cancel anytime.</p>
      <div class="pricing">
        <div>
          <strong>$199</strong>
          <span>/ month after trial</span>
        </div>
        <span class="badge">14-day free trial</span>
      </div>
      <button class="google">Continue with Google</button>
      <div class="divider"><span>or</span></div>
      <form class="auth-form">
        <label>
          Work email
          <input type="email" placeholder="you@company.com" required />
        </label>
        <label>
          Password
          <input type="password" placeholder="••••••••" required />
        </label>
        <label>
          Company name
          <input type="text" placeholder="Lending Co." required />
        </label>
        <button class="primary" type="submit">Create account</button>
      </form>
      <p class="small">
        By starting your trial you agree to our terms and to be charged after the trial unless you cancel in the
        Stripe customer portal.
      </p>
      <a class="link" href="/login">Already have an account? Log in.</a>
    </section>
  </main>
</BaseLayout>

<style lang="scss">
  @import '@styles/global.scss';

  .auth {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 3rem 1.5rem;
    background: var(--background);
  }

  .card {
    background: white;
    padding: 2.5rem;
    border-radius: 24px;
    box-shadow: 0 30px 80px rgba(15, 23, 42, 0.12);
    display: grid;
    gap: 1rem;
    max-width: 440px;
    width: 100%;
  }

  .card p {
    color: var(--text-color-secondary);
  }

  .pricing {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--background-darker);
    padding: 1rem;
    border-radius: 16px;
  }

  .pricing strong {
    font-size: 1.5rem;
  }

  .badge {
    background: rgba(27, 79, 255, 0.15);
    color: var(--primary);
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    font-size: 0.8rem;
  }

  .google {
    padding: 0.75rem 1rem;
    border-radius: 12px;
    border: 1px solid #d8def0;
    background: #f8faff;
    font-weight: 600;
    cursor: pointer;
  }

  .divider {
    text-align: center;
    color: var(--text-color-secondary);
  }

  .divider span {
    background: white;
    padding: 0 0.5rem;
  }

  .auth-form {
    display: grid;
    gap: 1rem;
  }

  .auth-form label {
    display: grid;
    gap: 0.5rem;
    font-weight: 500;
  }

  .auth-form input {
    padding: 0.75rem 1rem;
    border-radius: 12px;
    border: 1px solid #d8def0;
    background: #f8faff;
  }

  .primary {
    padding: 0.75rem 1rem;
    border-radius: 12px;
    border: none;
    background: var(--primary);
    color: white;
    font-weight: 600;
    cursor: pointer;
  }

  .small {
    font-size: 0.85rem;
  }

  .link {
    color: var(--primary);
  }
</style>
