---
import BaseLayout from '@layouts/Base.astro';
---

<BaseLayout title="Login | Addy AI" description="Login to your Addy AI account.">
  <main class="auth">
    <section class="card">
      <h1>Welcome back</h1>
      <p>Sign in to access your AI Loan Officer Assistant dashboard.</p>
      <button class="google">Continue with Google</button>
      <div class="divider"><span>or</span></div>
      <form class="auth-form">
        <label>
          Email address
          <input type="email" placeholder="you@company.com" required />
        </label>
        <label>
          Password
          <input type="password" placeholder="••••••••" required />
        </label>
        <button class="primary" type="submit">Log in</button>
      </form>
      <a class="link" href="/signup">Need an account? Start your free trial.</a>
    </section>
  </main>
</BaseLayout>

<style lang="scss">
  @import '@styles/global.scss';

  .auth {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 3rem 1.5rem;
    background: var(--background);
  }

  .card {
    background: white;
    padding: 2.5rem;
    border-radius: 24px;
    box-shadow: 0 30px 80px rgba(15, 23, 42, 0.12);
    display: grid;
    gap: 1rem;
    max-width: 420px;
    width: 100%;
  }

  .card p {
    color: var(--text-color-secondary);
  }

  .google {
    padding: 0.75rem 1rem;
    border-radius: 12px;
    border: 1px solid #d8def0;
    background: #f8faff;
    font-weight: 600;
    cursor: pointer;
  }

  .divider {
    text-align: center;
    color: var(--text-color-secondary);
  }

  .divider span {
    background: white;
    padding: 0 0.5rem;
  }

  .auth-form {
    display: grid;
    gap: 1rem;
  }

  .auth-form label {
    display: grid;
    gap: 0.5rem;
    font-weight: 500;
  }

  .auth-form input {
    padding: 0.75rem 1rem;
    border-radius: 12px;
    border: 1px solid #d8def0;
    background: #f8faff;
  }

  .primary {
    padding: 0.75rem 1rem;
    border-radius: 12px;
    border: none;
    background: var(--primary);
    color: white;
    font-weight: 600;
    cursor: pointer;
  }

  .link {
    color: var(--primary);
  }
</style>
